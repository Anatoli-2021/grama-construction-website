{
  "name": "grama-dexter-acres",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "build": "vite build",
    "preview": "node server.mjs --production",
    "verify": "node scripts/verify.mjs",
    "dev:os": "node apps/development-os/server.mjs",
    "dev:presentation": "node scripts/serve-presentation-review.mjs",
    "test": "node --test apps/development-os/test/*.test.mjs scripts/test/*.test.mjs",
    "start:web": "node scripts/serve-website.mjs --hosted",
    "check:repository": "node scripts/check-repository.mjs",
    "check": "npm run build && npm test && npm run check:repository"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "gsap": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "sharp": "latest"
  }
}
